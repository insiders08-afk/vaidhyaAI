# Copy to .env.local and add provider credentials.
# Never commit .env.local or real provider keys.

# Gnani Vachana / Prisma v3
TRANSCRIPTION_PROVIDER="gnani"
GNANI_API_KEY="your-gnani-api-key"
GNANI_API_URL="https://api.vachana.ai/stt/v3"
GNANI_STT_MODEL="prisma-v3.0"
GNANI_LANGUAGE_CODE="indic-auto"

# Output format: verbatim | transcribe | codemix | transliterate
GNANI_STT_FORMAT="transcribe"
GNANI_STT_TOPIC="Outpatient medical consultation"

# Optional vocabulary hints (up to 200 terms) and actual names (up to four).
GNANI_STT_KEYTERMS=""
GNANI_STT_SPEAKER_NAMES=""

# Optional NVIDIA Parakeet provider.
# TRANSCRIPTION_PROVIDER="nvidia_parakeet"
# NVIDIA_ASR_API_URL="https://integrate.api.nvidia.com/v1/asr/parakeet"
# NVIDIA_API_KEY="nvapi-your-key"

# LLM used for clinical note drafting (server-side).
OPENAI_API_KEY="sk-your-openai-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o"

# Optional generic LLM overrides.
# LLM_API_KEY=""
# LLM_API_URL=""
# LLM_MODEL=""

# Legacy browser-storage compatibility only.
# NEXT_PUBLIC values are bundled into browser code; this is not a server secret.
NEXT_PUBLIC_SECURE_STORAGE_KEY="base64-32-byte-key-for-local-demo-only"
