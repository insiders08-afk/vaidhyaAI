{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./build/tests-dist",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "declaration": false,
    "emitDeclarationOnly": false
  },
  "include": [
    "src/features/recording/**/*.ts",
    "src/server/transcription/**/*.ts",
    "src/server/clinical-notes/**/*.ts",
    "src/server/errors/**/*.ts",
    "src/server/llm/**/*.ts",
    "src/lib/storage/**/*.ts",
    "packages/pipeline/eval/src/**/*.ts",
    "packages/ui/src/lib/capability-status.ts",
    "packages/ui/src/lib/transcription-languages.ts",
    "packages/ui/src/lib/__tests__/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "build"
  ]
}
