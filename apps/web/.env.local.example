# Copy to apps/web/.env.local and add your provider credentials.

# Gnani Vachana / Prisma v3
TRANSCRIPTION_PROVIDER="gnani"
GNANI_API_KEY="your-gnani-api-key"
GNANI_API_URL="https://api.vachana.ai/stt/v3"
GNANI_STT_MODEL="prisma-v3.0"
GNANI_LANGUAGE_CODE="indic-auto"

# REST output format: verbatim | transcribe | codemix | transliterate
GNANI_STT_FORMAT="transcribe"
GNANI_STT_TOPIC="Outpatient medical consultation"

# Optional comma-separated clinical vocabulary hints (up to 200 terms).
# Example: HbA1c,Metformin,hypertension,ECG
GNANI_STT_KEYTERMS=""

# Optional actual names likely to be mentioned in the consultation (up to four).
# Do not use generic role words such as "Doctor" and "Patient".
GNANI_STT_SPEAKER_NAMES=""

# Optional NVIDIA Parakeet provider.
# TRANSCRIPTION_PROVIDER="nvidia_parakeet"
# NVIDIA_ASR_API_URL="https://integrate.api.nvidia.com/v1/asr/parakeet"
# NVIDIA_API_KEY="nvapi-your-key"

# LLM used for clinical note drafting (server-side).
OPENAI_API_KEY="sk-your-openai-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o"

# Optional generic LLM overrides.
# LLM_API_KEY=""
# LLM_API_URL=""
# LLM_MODEL=""

# Legacy browser-storage compatibility:
# NEXT_PUBLIC_ values are bundled into browser code. This is NOT a server
# secret or per-user key. Existing locally encrypted data may depend on it;
# do not change or remove it without a planned storage migration.
NEXT_PUBLIC_SECURE_STORAGE_KEY="base64-32-byte-key-for-local-demo-only"
