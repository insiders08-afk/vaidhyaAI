# Rename this file to .env.local and fill in your secrets.

# -----------------------------------------------------------------------------
# Vaidhya AI — Cloud-Only Speech-to-Text (Gnani Vachana REST STT v3)
# -----------------------------------------------------------------------------
# Transcription provider:
# - gnani (default: Gnani Vachana Prisma v3.0 multilingual STT)
# - nvidia_parakeet (optional future upgrade: NVIDIA Parakeet + Sortformer diarization)
TRANSCRIPTION_PROVIDER="gnani"

# Gnani AI API Key (sent via X-API-Key-ID header)
GNANI_API_KEY="your-gnani-api-key"
GNANI_API_URL="https://api.vachana.ai/stt/v3"
GNANI_STT_MODEL="prisma-v3.0"

# Default language hint:
# - indic-auto (default: automatic detection across 10 Indian languages + English)
# - Or comma-separated 1-4 codes: bn-IN, en-IN, gu-IN, hi-IN, kn-IN, ml-IN, mr-IN, pa-IN, ta-IN, te-IN
GNANI_LANGUAGE_CODE="indic-auto"

# -----------------------------------------------------------------------------
# Optional Future Upgrade: NVIDIA Parakeet + Sortformer Diarization
# (from github.com/NVIDIA-AI-Blueprints/ambient-healthcare-agents)
# Set TRANSCRIPTION_PROVIDER="nvidia_parakeet" when ready to switch
# -----------------------------------------------------------------------------
# NVIDIA_ASR_API_URL="https://integrate.api.nvidia.com/v1/asr/parakeet"
# NVIDIA_API_KEY="nvapi-your-nvidia-key"

# -----------------------------------------------------------------------------
# Reasoning LLM (OpenAI GPT or any OpenAI-compatible cloud endpoint)
# -----------------------------------------------------------------------------
OPENAI_API_KEY="sk-your-openai-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o"

# Optional generic LLM overrides (takes precedence if explicitly set)
# LLM_API_KEY=""
# LLM_API_URL=""
# LLM_MODEL=""

# -----------------------------------------------------------------------------
# Client-Side AES-GCM Session Storage Secret (base64 32-byte key)
# Generate with: openssl rand -base64 32 (or run `pnpm run setup`)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SECURE_STORAGE_KEY="base64-secret"
