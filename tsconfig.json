{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@audio": [
        "src/features/recording/index.ts"
      ],
      "@audio/*": [
        "src/features/recording/*"
      ],
      "@transcription": [
        "src/server/transcription/index.ts"
      ],
      "@transcription/*": [
        "src/server/transcription/*"
      ],
      "@transcript-assembly": [
        "src/server/transcription/assembly/index.ts"
      ],
      "@transcript-assembly/*": [
        "src/server/transcription/assembly/*"
      ],
      "@note-core": [
        "src/server/clinical-notes/index.ts"
      ],
      "@note-core/*": [
        "src/server/clinical-notes/*"
      ],
      "@note-rendering": [
        "packages/pipeline/render/src/index.ts"
      ],
      "@note-rendering/*": [
        "packages/pipeline/render/src/*"
      ],
      "@llm": [
        "src/server/llm/index.ts"
      ],
      "@llm/*": [
        "src/server/llm/*"
      ],
      "@pipeline-errors": [
        "src/server/errors/index.ts"
      ],
      "@pipeline-errors/*": [
        "src/server/errors/*"
      ],
      "@storage": [
        "src/lib/storage/index.ts"
      ],
      "@storage/*": [
        "src/lib/storage/*"
      ],
      "@ui": [
        "packages/ui/src/index.ts"
      ],
      "@ui/*": [
        "packages/ui/src/*"
      ],
      "@ui/lib/*": [
        "packages/ui/src/lib/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.mjs",
    "src/**/*.d.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "packages/**/*.js",
    "packages/**/*.mjs",
    "scripts/**/*.mjs",
    "scripts/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "build",
    ".next"
  ]
}
